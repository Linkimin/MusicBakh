<Application x:Class="MusicLibrary.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MusicLibrary.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Brushes.xaml" />
                <ResourceDictionary Source="Resources/ScrollBarStyles.xaml" />
                <ResourceDictionary Source="Resources/SliderStyles.xaml" />
                <ResourceDictionary Source="Resources/ButtonStyles.xaml" />
                <ResourceDictionary Source="Resources/ComboBoxStyles.xaml" />
                <ResourceDictionary Source="Resources/TextBoxStyles.xaml" />
                <ResourceDictionary Source="Resources/TabStyles.xaml" />
                <ResourceDictionary Source="Resources/ToolbarStyles.xaml" />
                <ResourceDictionary Source="Resources/TagChipStyles.xaml" />
                <ResourceDictionary Source="Resources/MainViewTabsStyles.xaml" />
                <ResourceDictionary Source="Resources/ListStyles.xaml" />
                <ResourceDictionary Source="Resources/PlayerIcons.xaml" />
                <ResourceDictionary Source="Resources/TrackTemplates.xaml" />
                <ResourceDictionary Source="Resources/AlbumsArtistsTemplates.xaml" />
                <ResourceDictionary Source="Resources/PlaylistsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="HeadingFont">Playfair Display, Georgia</FontFamily>
            <FontFamily x:Key="BodyFont">Montserrat, Segoe UI</FontFamily>

            <converters:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter"
                                                   InfoBrush="{StaticResource MutedForegroundBrush}"
                                                   SuccessBrush="{StaticResource SuccessBrush}"
                                                   ErrorBrush="{StaticResource ErrorBrush}" />
            <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:RatingThresholdToBrushConverter x:Key="RatingThresholdToBrushConverter"
                                                       FilledBrush="{StaticResource PrimaryBrush}"
                                                       EmptyBrush="{StaticResource MutedForegroundBrush}" />
            <converters:ReactionMatchToBrushConverter x:Key="ReactionMatchToBrushConverter"
                                                     ActiveBrush="{StaticResource PrimaryBrush}"
                                                     InactiveBrush="{StaticResource MutedForegroundBrush}" />
            <!-- Like — красное сердечко. Цвет совпадает с ErrorBrush (#E06C75),
                 потому что красный нужен только здесь, заводить новый ресурс — оверкилл. -->
            <converters:ReactionMatchToBrushConverter x:Key="LikeReactionToBrushConverter"
                                                     ActiveBrush="{StaticResource ErrorBrush}"
                                                     InactiveBrush="{StaticResource MutedForegroundBrush}" />
            <!-- Dislike — перечёркнутое сердечко: активное тёмно-серое (как «отвергнуто»),
                 неактивное приглушённое серое. Активное затемнение — намеренное:
                 визуально подчёркивает «не нравится». -->
            <converters:ReactionMatchToBrushConverter x:Key="DislikeReactionToBrushConverter"
                                                     ActiveBrush="#5C5C70"
                                                     InactiveBrush="{StaticResource MutedForegroundBrush}" />
            <converters:ZeroAsActiveBrushConverter x:Key="ZeroAsActiveBrushConverter"
                                                   ActiveBrush="{StaticResource PrimaryBrush}"
                                                   InactiveBrush="{StaticResource MutedForegroundBrush}" />
            <converters:TagsToFirstNConverter x:Key="TagsToFirstNConverter" />
            <converters:TagsOverflowCountConverter x:Key="TagsOverflowCountConverter" />
            <converters:TrackTagsLookupConverter x:Key="TrackTagsLookupConverter" />
            <converters:TrackTagsFirstNMultiConverter x:Key="TrackTagsFirstNMultiConverter" />
            <converters:TrackTagsOverflowCountMultiConverter x:Key="TrackTagsOverflowCountMultiConverter" />
            <converters:TrackTagsOverflowVisibilityMultiConverter x:Key="TrackTagsOverflowVisibilityMultiConverter" />

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
