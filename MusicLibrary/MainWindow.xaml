<Window x:Class="MusicLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MusicLibrary.Controls"
        xmlns:selectors="clr-namespace:MusicLibrary.Selectors"
        xmlns:domain="clr-namespace:MusicBakh.Core.Domain;assembly=MusicBakh.Core"
        Title="MusicBakh"
        Icon="Assets/Brand/musicbakh.ico"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">
<Window.Resources>
                            <Style x:Key="PlayPauseIconStyle" TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconPlayGeometry}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding IsPlaying}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Data" Value="{StaticResource IconPauseGeometry}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="MuteIconStyle" TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconVolumeGeometry}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconMutedGeometry}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="RepeatIconStyle" TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource MutedForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RepeatMode}" Value="Current">
                                        <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatMode}" Value="Library">
                                        <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="RepeatLabelStyle" TargetType="TextBlock">
                                <Setter Property="Text" Value="Off" />
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RepeatMode}" Value="Current">
                                        <Setter Property="Text" Value="1" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatMode}" Value="Library">
                                        <Setter Property="Text" Value="All" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding TogglePlaybackCommand}" />
        <!-- Все буквенные хоткеи — с Ctrl, чтобы не блокировать ввод этих букв
             в поле поиска и других TextBox-ах (в русской раскладке R=К, M=Ь). -->
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMuteCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding CycleRepeatModeCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding OpenStatsCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding OpenTagsCommand}" />
        <!-- Стрелки только с модификаторами: иначе их перехватывает ListBox треков
             (стрелки вверх/вниз/влево/вправо для навигации) или Slider громкости/seek. -->
        <KeyBinding Key="Left"  Modifiers="Shift"   Command="{Binding SkipBackwardCommand}" />
        <KeyBinding Key="Right" Modifiers="Shift"   Command="{Binding SkipForwardCommand}" />
        <KeyBinding Key="Left"  Modifiers="Control" Command="{Binding PreviousTrackCommand}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextTrackCommand}" />
        <!-- Ctrl+1/2/3 — переключение вкладок Треки/Альбомы/Исполнители (см. MainViewMode). -->
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SwitchViewCommand}">
            <KeyBinding.CommandParameter>
                <x:Static Member="domain:MainViewMode.Tracks" />
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SwitchViewCommand}">
            <KeyBinding.CommandParameter>
                <x:Static Member="domain:MainViewMode.Albums" />
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SwitchViewCommand}">
            <KeyBinding.CommandParameter>
                <x:Static Member="domain:MainViewMode.Artists" />
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SwitchViewCommand}">
            <KeyBinding.CommandParameter>
                <x:Static Member="domain:MainViewMode.Playlists" />
            </KeyBinding.CommandParameter>
        </KeyBinding>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindCommandExecuted" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="LibraryHeader" Background="{StaticResource CardOverlayBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Content="＋ Добавить трек" Command="{Binding AddTrackCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" FontSize="12" />
                <Button DockPanel.Dock="Right" Content="Статистика" Command="{Binding OpenStatsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" FontSize="12" Margin="0,0,12,0" ToolTip="Ctrl+T" />
                <Button DockPanel.Dock="Right" Content="Теги" Command="{Binding OpenTagsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" FontSize="12" Margin="0,0,12,0" ToolTip="Ctrl+G" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="40"
                           Height="40"
                           Source="Assets/Brand/musicbakh-logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MusicBakh" FontFamily="{StaticResource HeadingFont}" Foreground="{StaticResource PrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Музыкальная библиотека" Foreground="{StaticResource MutedForegroundBrush}" FontSize="13" Margin="1,2,0,0" />
                    </StackPanel>
                </StackPanel>

                </DockPanel><!-- Навигация отдельной строкой не пересекается с действиями при сужении окна. -->
                <StackPanel x:Name="LibraryNavigation" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button Content="Треки"
                            Command="{Binding SwitchViewCommand}">
                        <Button.CommandParameter>
                            <x:Static Member="domain:MainViewMode.Tracks" />
                        </Button.CommandParameter>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainViewTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveView}">
                                        <DataTrigger.Value>
                                            <x:Static Member="domain:MainViewMode.Tracks" />
                                        </DataTrigger.Value>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Альбомы"
                            Command="{Binding SwitchViewCommand}">
                        <Button.CommandParameter>
                            <x:Static Member="domain:MainViewMode.Albums" />
                        </Button.CommandParameter>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainViewTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveView}">
                                        <DataTrigger.Value>
                                            <x:Static Member="domain:MainViewMode.Albums" />
                                        </DataTrigger.Value>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Исполнители"
                            Command="{Binding SwitchViewCommand}">
                        <Button.CommandParameter>
                            <x:Static Member="domain:MainViewMode.Artists" />
                        </Button.CommandParameter>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainViewTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveView}">
                                        <DataTrigger.Value>
                                            <x:Static Member="domain:MainViewMode.Artists" />
                                        </DataTrigger.Value>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Плейлисты"
                            Command="{Binding SwitchViewCommand}">
                        <Button.CommandParameter>
                            <x:Static Member="domain:MainViewMode.Playlists" />
                        </Button.CommandParameter>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MainViewTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveView}">
                                        <DataTrigger.Value>
                                            <x:Static Member="domain:MainViewMode.Playlists" />
                                        </DataTrigger.Value>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FilterToolbarBorderStyle}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Поиск по библиотеке (Ctrl+F)" Height="40"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         KeyDown="OnSearchBoxKeyDown"
                         VerticalAlignment="Center" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Genres}"
                          SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"
                          Style="{StaticResource GenreComboBoxStyle}" Height="40"
                          MinWidth="140"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center" />

                <controls:OverflowChipPanel x:Name="TagChipsPanel"
                                            Grid.Column="2"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center" />

                <Button x:Name="MoreFiltersButton"
                        Grid.Column="3"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        Margin="14,0,0,0"
                        Content="⋮"
                        Click="OnMoreFiltersClick"
                        ToolTip="Рейтинг, реакция, сброс" />

                <Popup x:Name="MoreTagsPopup"
                       PlacementTarget="{Binding ElementName=TagChipsPanel}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Style="{StaticResource ToolbarPopupBorderStyle}" MinWidth="220" MaxWidth="320">
                        <StackPanel>
                            <TextBlock Text="Скрытые теги"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,8" />
                            <!-- ItemTemplate и ItemsSource выставляются в code-behind после
                                 формирования списка скрытых чипов; DataContext = MainViewModel. -->
                            <ItemsControl x:Name="HiddenTagsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Style="{StaticResource PopupResetButtonStyle}"
                                    Content="Обновить список"
                                    Command="{Binding RefreshTagFiltersCommand}"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="MoreFiltersPopup"
                       PlacementTarget="{Binding ElementName=MoreFiltersButton}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Style="{StaticResource ToolbarPopupBorderStyle}" Width="280">
                        <StackPanel>
                            <TextBlock Text="Минимальный рейтинг"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Style="{StaticResource PopupPillButtonStyle}"
                                        Content="Все"
                                        Command="{Binding SetMinRatingCommand}"
                                        CommandParameter="0"
                                        Margin="0,0,8,0">
                                    <Button.Foreground>
                                        <Binding Path="MinRating" Converter="{StaticResource ZeroAsActiveBrushConverter}" />
                                    </Button.Foreground>
                                </Button>
                                <Button Command="{Binding SetMinRatingCommand}" CommandParameter="1" Style="{StaticResource ToolbarIconButtonStyle}" Width="32" Height="32" Margin="0,0,2,0">
                                    <TextBlock Text="★" FontSize="22" Foreground="{Binding MinRating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=1}" />
                                </Button>
                                <Button Command="{Binding SetMinRatingCommand}" CommandParameter="2" Style="{StaticResource ToolbarIconButtonStyle}" Width="32" Height="32" Margin="0,0,2,0">
                                    <TextBlock Text="★" FontSize="22" Foreground="{Binding MinRating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=2}" />
                                </Button>
                                <Button Command="{Binding SetMinRatingCommand}" CommandParameter="3" Style="{StaticResource ToolbarIconButtonStyle}" Width="32" Height="32" Margin="0,0,2,0">
                                    <TextBlock Text="★" FontSize="22" Foreground="{Binding MinRating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=3}" />
                                </Button>
                                <Button Command="{Binding SetMinRatingCommand}" CommandParameter="4" Style="{StaticResource ToolbarIconButtonStyle}" Width="32" Height="32" Margin="0,0,2,0">
                                    <TextBlock Text="★" FontSize="22" Foreground="{Binding MinRating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=4}" />
                                </Button>
                                <Button Command="{Binding SetMinRatingCommand}" CommandParameter="5" Style="{StaticResource ToolbarIconButtonStyle}" Width="32" Height="32">
                                    <TextBlock Text="★" FontSize="22" Foreground="{Binding MinRating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=5}" />
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Реакция"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Style="{StaticResource PopupPillButtonStyle}"
                                        Content="Все"
                                        Command="{Binding SetReactionFilterCommand}"
                                        CommandParameter="Any"
                                        Margin="0,0,8,0">
                                    <Button.Foreground>
                                        <Binding Path="ReactionFilter" Converter="{StaticResource ReactionMatchToBrushConverter}" ConverterParameter="Any" />
                                    </Button.Foreground>
                                </Button>
                                <Button Command="{Binding SetReactionFilterCommand}" CommandParameter="Liked"
                                        Style="{StaticResource ToolbarIconButtonStyle}" Width="40" Height="36" Margin="0,0,6,0">
                                    <TextBlock Text="♥" FontSize="18"
                                               Foreground="{Binding ReactionFilter, Converter={StaticResource LikeReactionToBrushConverter}, ConverterParameter=Liked}" />
                                </Button>
                                <Button Command="{Binding SetReactionFilterCommand}" CommandParameter="Disliked"
                                        Style="{StaticResource ToolbarIconButtonStyle}" Width="40" Height="36">
                                    <Grid Width="22" Height="22">
                                        <TextBlock Text="♥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding ReactionFilter, Converter={StaticResource DislikeReactionToBrushConverter}, ConverterParameter=Disliked}" />
                                        <Line X1="2" Y1="20" X2="20" Y2="2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding ReactionFilter, Converter={StaticResource DislikeReactionToBrushConverter}, ConverterParameter=Disliked}" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Button Style="{StaticResource PopupResetButtonStyle}"
                                    Content="Сбросить все фильтры"
                                    Command="{Binding ClearFiltersCommand}"
                                    Click="OnResetFiltersClick" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#4D16161F" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <ContentControl Content="{Binding CurrentLeftColumn}">
                        <ContentControl.ContentTemplateSelector>
                            <selectors:LeftColumnTemplateSelector
                                TracksTemplate="{StaticResource TracksRootTemplate}"
                                AlbumsTemplate="{StaticResource AlbumsRootTemplate}"
                                ArtistsTemplate="{StaticResource ArtistsRootTemplate}"
                                AlbumDetailTemplate="{StaticResource AlbumDetailTemplate}"
                                ArtistDetailTemplate="{StaticResource ArtistDetailTemplate}"
                                PlaylistsTemplate="{StaticResource PlaylistsRootTemplate}"
                                PlaylistDetailTemplate="{StaticResource PlaylistDetailTemplate}" />
                        </ContentControl.ContentTemplateSelector>
                    </ContentControl>
                </DockPanel>
            </Border>

            <Border x:Name="TrackEditor" Grid.Column="1" Background="#3316161F" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">


                        <TextBlock Text="ВЫБРАННЫЙ ТРЕК" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="92" Height="92" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="6">
                                <Border.Background><ImageBrush ImageSource="{Binding SelectedTrack.CoverPath}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SelectedTrack.Title, TargetNullValue='Выберите трек'}" Foreground="{StaticResource ForegroundBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedTrack.Artist}" Foreground="{StaticResource MutedForegroundBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SelectedTrack.Genre}" Foreground="{StaticResource PrimaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedTrack.DurationText}" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- Рейтинг + реакция: видимы только когда выбран трек. -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14"
                                    Visibility="{Binding HasSelectedTrack, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel.Resources>
                                <Style x:Key="GlyphButtonStyle" TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <!-- Рейтинг и реакция помещаются в редактор шириной 360 DIP. -->
                            <StackPanel x:Name="RatingControls" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetRatingCommand}" CommandParameter="1" ToolTip="1 звезда">
                                    <TextBlock Text="★" FontSize="26"
                                               Foreground="{Binding SelectedTrack.Rating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=1}" />
                                </Button>
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetRatingCommand}" CommandParameter="2" ToolTip="2 звезды">
                                    <TextBlock Text="★" FontSize="26"
                                               Foreground="{Binding SelectedTrack.Rating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=2}" />
                                </Button>
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetRatingCommand}" CommandParameter="3" ToolTip="3 звезды">
                                    <TextBlock Text="★" FontSize="26"
                                               Foreground="{Binding SelectedTrack.Rating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=3}" />
                                </Button>
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetRatingCommand}" CommandParameter="4" ToolTip="4 звезды">
                                    <TextBlock Text="★" FontSize="26"
                                               Foreground="{Binding SelectedTrack.Rating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=4}" />
                                </Button>
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetRatingCommand}" CommandParameter="5" ToolTip="5 звёзд">
                                    <TextBlock Text="★" FontSize="26"
                                               Foreground="{Binding SelectedTrack.Rating, Converter={StaticResource RatingThresholdToBrushConverter}, ConverterParameter=5}" />
                                </Button>
                            <!-- Лайк: сердечко краснеет при активации. -->
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetReactionCommand}" CommandParameter="Liked" ToolTip="Лайк" Margin="16,0,0,0">
                                    <TextBlock Text="♥" FontSize="32"
                                               Foreground="{Binding SelectedTrack.Reaction, Converter={StaticResource LikeReactionToBrushConverter}, ConverterParameter=Liked}" />
                                </Button>
                                <!-- Дизлайк: сердечко + диагональная линия через Grid-overlay.
                                     Цвет линии и сердечка синхронизированы через общий конвертер. -->
                                <Button Style="{StaticResource GlyphButtonStyle}" Padding="4" Command="{Binding SetReactionCommand}" CommandParameter="Disliked" ToolTip="Дизлайк" Margin="6,0,0,0">
                                    <Grid Width="32" Height="38">
                                        <TextBlock Text="♥" FontSize="32"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding SelectedTrack.Reaction, Converter={StaticResource DislikeReactionToBrushConverter}, ConverterParameter=Disliked}" />
                                        <!-- Диагональная линия слева-снизу к справа-сверху, чуть с запасом за границы глифа. -->
                                        <Line X1="2" Y1="34" X2="30" Y2="4"
                                              StrokeThickness="2.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding SelectedTrack.Reaction, Converter={StaticResource DislikeReactionToBrushConverter}, ConverterParameter=Disliked}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Разделитель между рейтингом/реакциями и секцией тегов. -->
                        <Border Height="1" Background="#D4A57420" Margin="0,6,0,8"
                                Visibility="{Binding HasSelectedTrack, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Секция «Теги»: чипы привязанных к выбранному треку + кнопка «+ тег». -->
                        <StackPanel Visibility="{Binding HasSelectedTrack, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,14">
                            <TextBlock Text="Теги" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" Margin="0,0,0,6" />
                            <ItemsControl>
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource TrackTagsLookupConverter}">
                                        <Binding Path="SelectedTrack.Id" />
                                        <Binding Path="TagsByTrackId" />
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChipStyle}" Padding="8,3" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TagChipTextStyle}" />
                                                <Button Margin="6,0,0,0" Padding="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.DetachTagFromSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Открепить">
                                                    <TextBlock Text="×" FontSize="14" Foreground="{StaticResource MutedForegroundBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddTagButton"
                                    Style="{StaticResource MoreChipButtonStyle}"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    Content="+ тег"
                                    Click="OnAddTagClick" />
                        </StackPanel>

                        <!-- Popup со списком доступных для привязки тегов. -->
                        <Popup x:Name="AddTagPopup"
                               PlacementTarget="{Binding ElementName=AddTagButton}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Style="{StaticResource ToolbarPopupBorderStyle}" MinWidth="180" MaxWidth="280">
                                <StackPanel>
                                    <TextBlock Text="Доступные теги" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" Margin="0,0,0,8" />
                                    <ItemsControl x:Name="AvailableTagsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TagChipStyle}" Padding="6,3" Margin="0,0,6,6" Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.AttachTagToSelectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TagChipTextStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Border Visibility="{Binding ShowOtherPlayingBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#1AD4A574" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,18">
                            <TextBlock Text="{Binding OtherPlayingText}" Foreground="{StaticResource PrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button x:Name="PlaySelectedButton" Padding="12,4" Content="Воспроизвести выбранный" Command="{Binding PlayTrackCommand}" CommandParameter="{Binding SelectedTrack}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Content="Сохранить копию…" Command="{Binding SaveTrackCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="Удалить трек" Command="{Binding DeleteTrackCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="8,4" Margin="4,0,0,0" Foreground="{StaticResource ErrorBrush}" IsEnabled="{Binding CanDeleteSelected}"/>
                    </UniformGrid>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#4D16161F" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="История" ToolTip="История прослушиваний" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,18" />
                    <ListBox ItemsSource="{Binding PlaybackHistory}"
                             ItemTemplate="{StaticResource HistoryItemTemplate}"
                             Style="{StaticResource PanelListBoxStyle}" />
                </DockPanel>
            </Border>
        </Grid>
        <!-- Транспорт закреплён независимо от прокрутки и выделения в библиотеке. -->
        <Border x:Name="PlayerTransport" Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,1,0,0" Padding="20,8,20,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding NowPlayingTrack.Title, TargetNullValue='Выберите музыку'}" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NowPlayingTrack.Artist}" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPositionText}" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekSliderStyle}" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}" IsMoveToPointEnabled="True" IsEnabled="{Binding PlayingTrack, Converter={StaticResource NullToBooleanConverter}}" Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted" PreviewMouseUp="OnSeekPreviewMouseUp" PreviewKeyUp="OnSeekKeyUp" AutomationProperties.Name="Позиция воспроизведения"/>
                    <TextBlock Grid.Column="2" Text="{Binding CurrentDurationText}" Foreground="{StaticResource MutedForegroundBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PreviousTrackCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Предыдущий (Ctrl+←)" AutomationProperties.Name="Предыдущий трек"><Path Data="{StaticResource IconPrevGeometry}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/></Button>
                    <Button Command="{Binding SkipBackwardCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Назад на 10 секунд" AutomationProperties.Name="Назад на 10 секунд"><Path Data="{StaticResource IconSkipBack10Geometry}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/></Button>
                    <Button x:Name="TransportPlayButton" Command="{Binding TogglePlaybackCommand}" Style="{StaticResource PrimaryIconButtonStyle}" Width="46" Height="46" ToolTip="Воспроизвести / пауза (Space)" AutomationProperties.Name="Воспроизвести или приостановить"><Path Style="{StaticResource PlayPauseIconStyle}" Fill="{StaticResource BackgroundBrush}" Width="20" Height="20" Stretch="Uniform"/></Button>
                    <Button Command="{Binding SkipForwardCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Вперёд на 10 секунд" AutomationProperties.Name="Вперёд на 10 секунд"><Path Data="{StaticResource IconSkipForward10Geometry}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/></Button>
                    <Button Command="{Binding NextTrackCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Следующий (Ctrl+→)" AutomationProperties.Name="Следующий трек"><Path Data="{StaticResource IconNextGeometry}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/></Button>
                    <Button Command="{Binding StopCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Остановить" AutomationProperties.Name="Остановить"><Rectangle Width="12" Height="12" Fill="{StaticResource PrimaryBrush}"/></Button>
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Без звука (Ctrl+M)" AutomationProperties.Name="Без звука"><Path Style="{StaticResource MuteIconStyle}" Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource PrimaryBrush}"/></Button>
                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource VolumeSliderStyle}" AutomationProperties.Name="Громкость"/>
                    <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center" FontSize="11" TextAlignment="Right"/>
                    <Button Grid.Column="3" Command="{Binding CycleRepeatModeCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Режим повтора (Ctrl+R)" AutomationProperties.Name="Режим повтора"><StackPanel><Path Data="{StaticResource IconRepeatGeometry}" Style="{StaticResource RepeatIconStyle}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Style="{StaticResource RepeatLabelStyle}" FontSize="9" TextAlignment="Center"/></StackPanel></Button>
                </Grid>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" FontSize="11" Margin="0,5,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
